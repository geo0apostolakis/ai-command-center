# Demo mode: canned answers, no API keys, no network calls.
DEMO_MODE=true

# Chat model (all three agents), through OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Librarian retrieval: OpenAI embeddings stored in a Pinecone index
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=command-center

# Outlook drafts through Microsoft Graph (app registration, client credentials).
# Leave empty and drafts are logged to the console instead.
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_FROM_EMAIL=

PORT=8800
# No login in this app, so it listens on this machine only by default.
HOST=127.0.0.1
